# Copy this file to .env and fill in your values

# ── AI ───────────────────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

GEMINI_MODEL=gemini-2.5-flash

# Valuation is an extraction task, not a creative one. The API default is 1.0 —
# full sampling randomness — which made the same photo return different prices
# on repeat scans. Keep this low; `backend/eval` measures the consequence as the
# `consistency` metric.
GEMINI_TEMPERATURE=0.15
GEMINI_TOP_P=0.90
GEMINI_SEED=20260728

# Constrained JSON decoding. Set to 0 only if a future model regresses on it —
# the regex extractor remains as a fallback either way.
GEMINI_JSON_MODE=1

# Ceilings. Without them a pathological response is unbounded in latency + cost.
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_LISTING_MAX_TOKENS=800

# Retries are classified: malformed requests and auth failures are never retried.
GEMINI_RETRY_ATTEMPTS=2
GEMINI_RETRY_BASE_DELAY=0.5

# Which valuation prompt serves traffic: v1 (legacy) or v2 (structured
# reasoning). Env-switchable so a rollback is config, not a redeploy.
SCAN_PROMPT_VERSION=v2

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to "json" in production so logs are machine-parseable.
LOG_FORMAT=json

# ── Environment ──────────────────────────────────────────────────────────────
# Set to "production" to enable strict startup checks (currently: refuses to
# boot without TOKEN_KEYS, which would otherwise sign every user out on deploy).
ENVIRONMENT=development

# ── Cache / rate limiting ────────────────────────────────────────────────────
# REQUIRED before running more than one replica. Without it, rate limits, quota
# and entitlements are per-process and reset on every deploy.
#
# NOTE: once set, quota and entitlement checks FAIL CLOSED if Redis is
# unreachable — a 503, not a free scan. Leaving it empty is the only way to
# declare "this single instance's memory is authoritative". Setting it and then
# losing Redis is not the same thing, and is no longer treated as such.
REDIS_URL=
REDIS_MAX_CONNECTIONS=50

# ── Limits ───────────────────────────────────────────────────────────────────
RATE_MAX_REQUESTS=20
IP_RATE_MAX_REQUESTS=60
FREE_SCANS_PER_DAY=3

# ── Build identity ───────────────────────────────────────────────────────────
# Both OPTIONAL — /health reports sensible values with neither set.
#
# The commit reported by GET /health resolves in this order:
#   GIT_COMMIT  ->  RAILWAY_GIT_COMMIT_SHA  ->  "unknown"
# Railway injects RAILWAY_GIT_COMMIT_SHA into every deployment automatically,
# so on Railway there is nothing to configure: /health will report the live
# commit on its own. Set GIT_COMMIT only when building the image elsewhere.
GIT_COMMIT=
# Labels the backend build. Defaults to the value baked into main.py. This is
# the BACKEND version and is intentionally NOT the iOS app's MARKETING_VERSION —
# the two ship independently, so tying them would make both numbers lie.
RELEASE_VERSION=

# ── Observability ────────────────────────────────────────────────────────────
# Bearer token required to scrape GET /metrics. FAILS CLOSED: with this unset
# the endpoint returns 404 and serves nothing, so a deploy that forgets it loses
# metrics until it is set. That is deliberate — defaulting to open would mean
# the guard does nothing on exactly the hosts that forgot to configure it.
#
# The exposition carries no user data, but on a public host it publishes request
# volumes, error rates and model token usage: a free scale and cost oracle, and
# a live read on whether an attack is landing.
#
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Health probes (/health/live, /health/ready) stay anonymous and are unaffected.
METRICS_TOKEN=

# ── Networking ───────────────────────────────────────────────────────────────
# Only enable behind a proxy that overwrites X-Forwarded-For (Railway does).
TRUSTED_PROXY=true
# Comma-separated. Leave empty for a native-only client — CORS is opt-in.
ALLOWED_ORIGINS=

# ── Authentication (App Attest) ──────────────────────────────────────────────
APPLE_TEAM_ID=A93FGV7L5Y
APPLE_BUNDLE_ID=eu.snapworth.app

# Master switch. Leave OFF until a client build with attestation is live in the
# App Store, otherwise existing installs are locked out. Turning it on without
# APPLE_TEAM_ID set refuses to boot rather than rejecting every user.
REQUIRE_APP_ATTEST=false

# Accept development-environment attestations. NEVER true in production: it
# would let a debug build call the API.
APP_ATTEST_ALLOW_DEV=false

# ── Token signing ────────────────────────────────────────────────────────────
# Format: kid:secret[,kid:secret...]. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotation: add a second key, wait one token lifetime (1h), make it current,
# then drop the old one. Both are accepted for verification meanwhile.
TOKEN_KEYS=
TOKEN_CURRENT_KID=

# ── DeviceCheck (reinstall resistance) ───────────────────────────────────────
# Optional. Without it, a reinstall gets a fresh free-scan allowance.
# Create a key at developer.apple.com → Certificates, IDs & Profiles → Keys,
# then paste the .p8 contents (newlines escaped as \n).
DEVICECHECK_KEY_ID=
DEVICECHECK_PRIVATE_KEY=
DEVICECHECK_SANDBOX=false

# ── StoreKit entitlements ────────────────────────────────────────────────────
# Which StoreKit environments grant Pro. Comma-separated; Production only by
# default.
#
# Sandbox transactions are signed by the SAME Apple certificate chain as
# production ones, so every signature/bundle/product check passes for a free
# Sandbox tester subscription. This list is the only thing separating them.
#
# TestFlight builds receive *Sandbox* transactions. To exercise purchases from
# TestFlight, point that build at a staging deployment with
# ALLOWED_STOREKIT_ENVIRONMENTS=Sandbox — never widen production.
ALLOWED_STOREKIT_ENVIRONMENTS=Production

# How many attested devices one subscription may entitle. The signed transaction
# reaches the client in plaintext and can be shared; 6 matches Apple's Family
# Sharing limit, so it is invisible to honest households.
MAX_DEVICES_PER_SUBSCRIPTION=6

# ── Audit ────────────────────────────────────────────────────────────────────
# Salt for pseudonymising subjects in the audit log. Rotating it breaks
# historical correlation, which is the intended privacy/forensics trade.
AUDIT_SALT=change-me-in-production

# ── Comparable sales engine ──────────────────────────────────────────────────
# See docs/COMPS-ENGINE.md. No bundled provider requires credentials; real
# marketplace integrations are gated on the legal review in COMPS-ARCHITECTURE.md.
#
# Going live requires BOTH of the first two variables to change. Enabling one
# alone cannot serve a comps-backed claim — that is deliberate.
COMPS_ENABLED=false
COMPS_SHADOW_MODE=true

# Comma-separated allowlists. Empty means "all registered and enabled".
# Phase 1 should be COMPS_CATEGORIES=clothing,shoes
COMPS_PROVIDERS=
COMPS_CATEGORIES=

# Comps must never add a visible second to a scan: whatever has returned when
# the fan-out budget expires is used and the rest are cancelled.
COMPS_FANOUT_BUDGET_MS=800
COMPS_PROVIDER_TIMEOUT_MS=700

COMPS_WINDOW_DAYS=90
COMPS_LONG_WINDOW_DAYS=180
COMPS_MAX_RESULTS=50

# The negative cache matters as much as the positive one: unidentifiable items
# are the most-scanned and the least likely to ever return a comp.
COMPS_CACHE_TTL=86400
COMPS_NEGATIVE_CACHE_TTL=21600

# ── Production operations ────────────────────────────────────────────────────
# Time allowed for in-flight requests to drain on SIGTERM before connections
# close. A scan legitimately takes ~6s, so a shorter drain kills real work.
# Must stay below the platform's SIGKILL grace period (Railway: 30s) and below
# uvicorn's --timeout-graceful-shutdown (20s, set in the Dockerfile).
DRAIN_TIMEOUT_SECONDS=15

# Surfaced on the snapworth_build_info metric so a dashboard can annotate
# deploys and correlate a regression with a specific release.
GIT_COMMIT=

# Pooled connections to Apple DeviceCheck. Called on attestation and quota
# exhaustion, not on the hot scan path, so a large pool holds idle sockets.
DEVICECHECK_MAX_CONNECTIONS=10

# Access-log sampling, 0.0-1.0. At high volume, access logs for frequent
# low-information endpoints dominate log spend while telling you nothing an
# aggregate metric doesn't. Records at WARNING and above are NEVER sampled —
# a dropped error is an incident you cannot investigate.
ACCESS_LOG_SAMPLE_RATE=1.0
