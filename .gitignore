# Environment / secrets
.env
*.env

# Apple signing keys. The In-App Purchase key that `appstorestatus.py` uses and
# the DeviceCheck key are both unencrypted P-256 .p8 files downloadable exactly
# once, and both land in ~/Downloads with a name that invites `mv` into the
# repo next to the tool that wants them. Ignored by extension so that reflex is
# harmless; .gitleaks.toml carries the matching rule for one committed anyway.
*.p8
# .p12 is the other shape an Apple credential comes in: a signing or push
# certificate exported from Keychain with its private key. Nothing here uses
# one, which is the point: there is no reason for one ever to be in the tree.
*.p12

# Python
__pycache__/
*.pyc
.venv/
venv/

# Xcode / iOS
xcuserdata/
*.xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# macOS
.DS_Store
.vercel

# Raw device captures for the App Store screenshots. Eight full-resolution
# PNGs per set, read by marketing/build_screenshots.py; only the composites
# it writes are committed.
marketing/screenshots/*/captures/

# Written by CI immediately before deploy so /health can report the live
# commit. Generated per-deploy — never committed.
backend/BUILD_COMMIT

# Gold-set photos, receipts and screenshots (#213): the private store is
# mounted here. The repo is public; only labels live in git.
backend/eval/data/images/

# Second-hand clothing eval: the /scan answer cache and run outputs. The
# dataset itself (26.8 GB, read in place from EVAL_DATA_DIR) never enters the
# repo; only the label manifests beside these folders are committed.
backend/eval/data/secondhand/cache/
backend/eval/data/secondhand/runs/
backend/eval/data/secondhand/**/*.jpg
backend/eval/data/secondhand/**/*.jpeg
backend/eval/data/secondhand/**/*.png
backend/eval/data/secondhand/**/*.zip

# Rack scan's test photos and their marked-up runs (#89): shop photos, which
# can show other people. Only the review file lives in git.
backend/eval/data/rack/images/
backend/eval/data/rack/runs/

# The software factory's job folders (.claude/skills/factory): runtime state
# written by its agents on every /factory run. 003 is the committed example.
factory/jobs/*
!factory/jobs/003-rate-limiting/
