    "Every sale price you've shared from this iPhone is deleted from SnapWorth's server, and sharing is turned off." : {
      "comment" : "Confirmation message before deleting shared sale outcomes. Deleting them also turns the Share sale prices setting off.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Verkaufspreis, den du von diesem iPhone geteilt hast, wird vom Server von SnapWorth gelöscht, und das Teilen wird ausgeschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every sale price you've shared from this iPhone is deleted from SnapWorth's server, and sharing is turned off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan del servidor de SnapWorth todos los precios de venta que compartiste desde este iPhone y se desactiva la opción de compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les prix de vente partagés depuis cet iPhone sont supprimés du serveur de SnapWorth, et le partage est désactivé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni prezzo di vendita condiviso da questo iPhone viene eliminato dal server di SnapWorth, e la condivisione viene disattivata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneから共有したすべての販売価格がSnapWorthのサーバーから削除され、共有はオフになります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie ceny sprzedaży udostępnione z tego iPhone'a zostaną usunięte z serwera SnapWorth, a udostępnianie zostanie wyłączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os preços de venda que você compartilhou deste iPhone são apagados do servidor do SnapWorth, e o compartilhamento é desativado."
