    "SnapWorth couldn't verify its secure connection to the server. If you're on public or work Wi-Fi, try mobile data instead." : {
      "comment" : "The phone refused the server's certificate (a failed chain or a pinned key that did not match). Deliberately not 'check your connection and try again': on an intercepting network the advice is to leave it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth konnte die sichere Verbindung zum Server nicht überprüfen. Wenn du in einem öffentlichen WLAN oder im Firmen-WLAN bist, versuch es stattdessen mit mobilen Daten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth couldn't verify its secure connection to the server. If you're on public or work Wi-Fi, try mobile data instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth no pudo verificar su conexión segura con el servidor. Si estás en una red wifi pública o del trabajo, prueba con datos móviles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth n'a pas pu vérifier sa connexion sécurisée au serveur. Si tu es sur un Wi-Fi public ou professionnel, essaie plutôt les données mobiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth non è riuscito a verificare la connessione sicura al server. Se sei su una rete Wi-Fi pubblica o di lavoro, prova con i dati cellulare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorthはサーバーとの安全な接続を確認できませんでした。公共や職場のWi-Fiをお使いの場合は、モバイルデータをお試しください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth nie mógł zweryfikować bezpiecznego połączenia z serwerem. Jeśli korzystasz z publicznej lub firmowej sieci Wi-Fi, spróbuj danych komórkowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SnapWorth não conseguiu verificar a conexão segura com o servidor. Se estiver em um Wi-Fi público ou do trabalho, tente os dados móveis."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth n-a putut verifica conexiunea securizată cu serverul. Dacă ești pe o rețea Wi-Fi publică sau de la birou, încearcă datele mobile."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth 无法验证与服务器的安全连接。如果你连的是公共或公司 Wi-Fi，请改用移动数据。"
          }
        }
      }
    },
    "SnapWorth has a new icon. Prefer another? Pick Night, Wow or the classic one, here or any time in Settings." : {
      "comment" : "Message of the one-time app icon alert. Night, Wow and Classic are the choices' names; use the same words as their own entries.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth hat ein neues Symbol. Lieber ein anderes? Wähl Nacht, Wow oder das klassische, hier oder jederzeit in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth has a new icon. Prefer another? Pick Night, Wow or the classic one, here or any time in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth tiene un icono nuevo. ¿Prefieres otro? Elige Noche, Wow o el clásico, aquí o cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth a une nouvelle icône. Tu en préfères une autre ? Choisis Nuit, Wow ou la classique, ici ou à tout moment dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth ha una nuova icona. Ne preferisci un'altra? Scegli Notte, Wow o la classica, qui o in qualsiasi momento in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorthのアイコンが新しくなりました。別のがいいですか？ここか設定でいつでも、ナイト、ワオ、クラシックから選べます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth ma nową ikonę. Wolisz inną? Wybierz Noc, Wow lub klasyczną, tutaj albo w dowolnej chwili w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SnapWorth tem um ícone novo. Prefere outro? Escolha Noite, Uau ou o clássico, aqui ou quando quiser nos Ajustes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth are o pictogramă nouă. Preferi alta? Alege Noapte, Uau sau pe cea clasică, aici sau oricând din Setări."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
