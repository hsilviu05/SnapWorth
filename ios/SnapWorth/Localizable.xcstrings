    "Scanning from this device is paused for 24 hours after repeated photos that could not be analysed." : {
      "comment" : "An error the server sent with a code this build words itself (backend/core/apierrors.py). In English the server's own sentence is shown instead.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannen ist auf diesem Gerät für 24 Stunden pausiert, nachdem mehrere Fotos nicht analysiert werden konnten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanning from this device is paused for 24 hours after repeated photos that could not be analysed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
