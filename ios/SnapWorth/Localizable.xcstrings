    "Only a few recent sales to compare. Start near the top of the range; you can always lower it." : {
      "comment" : "Tag's tip when the scan found fewer than five sold listings.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur wenige aktuelle Verkäufe zum Vergleich. Starte nahe am oberen Ende der Spanne; senken kannst du immer noch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only a few recent sales to compare. Start near the top of the range; you can always lower it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay pocas ventas recientes para comparar. Empieza cerca del máximo del rango; siempre puedes bajarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peu de ventes récentes à comparer. Commence près du haut de la fourchette ; tu pourras toujours baisser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poche vendite recenti da confrontare. Parti vicino al massimo dell'intervallo; puoi sempre abbassare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比べられる最近の販売が少なめです。範囲の上のほうから始めましょう。値下げはいつでもできます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mało ostatnich sprzedaży do porównania. Zacznij blisko górnej granicy; zawsze możesz obniżyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poucas vendas recentes para comparar. Comece perto do topo da faixa; dá para baixar depois."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunt doar câteva vânzări recente de comparat. Pornește de aproape de capătul de sus al intervalului; poți oricând să scazi prețul."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
