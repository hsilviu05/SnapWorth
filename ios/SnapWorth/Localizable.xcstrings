    "Your scans are saved to your closet so you can watch the hidden value add up over time." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Scans landen in deiner Sammlung, damit du siehst, wie sich der Wert mit der Zeit summiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your scans are saved to your closet so you can watch the hidden value add up over time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus escaneos se guardan en tu colección para que veas cómo se acumula el valor con el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes scans sont enregistrés dans ton dressing pour que tu voies la valeur cachée grimper au fil du temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue scansioni vengono salvate nel tuo armadio, così vedi il valore nascosto crescere nel tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンはクローゼットに保存され、眠っている価値が積み上がっていく様子を見られます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje skany trafiają do Twojej szafy, żebyś widział(a), jak ukryta wartość rośnie z czasem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus escaneamentos ficam salvos no seu acervo para você ver o valor escondido crescer com o tempo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanările se salvează în colecția ta, ca să vezi cum se adună valoarea în timp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描都会存进你的收藏，让你看着这些藏着的价值一点点累积起来。"
          }
        }
      }
    },
    "Your server data was deleted." : {
      "comment" : "After Delete my server data succeeded.",
