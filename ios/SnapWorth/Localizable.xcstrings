    },
    "SnapWorth couldn't confirm your Pro subscription yet, so the rest of this haul is on hold. Your photos are kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth konnte dein Pro-Abo noch nicht bestätigen, deshalb wartet der Rest des Stapels. Deine Fotos bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth couldn't confirm your Pro subscription yet, so the rest of this haul is on hold. Your photos are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth aún no ha podido confirmar tu suscripción Pro, así que el resto del lote queda en espera. Tus fotos se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
