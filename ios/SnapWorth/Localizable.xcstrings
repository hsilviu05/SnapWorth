        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth n'a pas pu ouvrir ta collection à ce lancement, cette trouvaille ne peut donc pas y être enregistrée. Rouvrir l'app peut régler le problème."
