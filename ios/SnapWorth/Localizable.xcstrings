    "SnapWorth couldn't open your library on this launch, so this find can't be saved to it. Reopening the app may fix it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth konnte deine Sammlung bei diesem Start nicht öffnen, deshalb lässt sich dieser Fund nicht darin speichern. Die App neu zu öffnen hilft vielleicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth couldn't open your library on this launch, so this find can't be saved to it. Reopening the app may fix it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth no pudo abrir tu colección en este arranque, así que este hallazgo no se puede guardar en ella. Reabrir la app puede arreglarlo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth n-a putut deschide colecția la pornirea asta, așa că găselnița nu poate fi salvată în ea. Repornirea aplicației poate rezolva."
          }
        }
      }
    },
