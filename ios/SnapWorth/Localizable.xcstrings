          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth non è ancora riuscito a confermare il tuo abbonamento Pro, quindi il resto del lotto è in attesa. Le tue foto vengono conservate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorthがまだProサブスクリプションを確認できないため、まとめの残りは保留中です。写真は保存されています。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth nie mógł jeszcze potwierdzić Twojej subskrypcji Pro, więc reszta partii czeka. Twoje zdjęcia są zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SnapWorth ainda não conseguiu confirmar sua assinatura Pro, então o resto deste lote está em espera. Suas fotos ficam guardadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth nu a putut confirma încă abonamentul Pro, așa că restul lotului așteaptă. Fotografiile tale sunt păstrate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth 暂时无法确认你的 Pro 订阅，本批其余照片先暂缓。照片不会丢失。"
          }
        }
      }
    },
    "SnapWorth couldn't open your library on this launch, so this find can't be saved to it. Reopening the app may fix it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth konnte deine Sammlung bei diesem Start nicht öffnen, deshalb lässt sich dieser Fund nicht darin speichern. Die App neu zu öffnen hilft vielleicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth couldn't open your library on this launch, so this find can't be saved to it. Reopening the app may fix it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth no pudo abrir tu colección en este arranque, así que este hallazgo no se puede guardar en ella. Reabrir la app puede arreglarlo."
