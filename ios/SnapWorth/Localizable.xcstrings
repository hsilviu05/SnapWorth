    "SnapWorth writes it — you paste & post. We never post for you." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth schreibt es – du kopierst und stellst ein. Wir stellen nie für dich ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth writes it — you paste & post. We never post for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth lo escribe: tú copias y publicas. Nunca publicamos por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth la rédige, tu colles et tu publies. Nous ne publions jamais à ta place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth lo scrive, tu incolli e pubblichi. Non pubblichiamo mai al posto tuo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorthが書いて、あなたは貼り付けて投稿するだけ。代わりに投稿することはありません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth pisze, Ty wklejasz i publikujesz. Nigdy nie publikujemy za Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SnapWorth escreve, você cola e publica. Nunca publicamos por você."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth îl scrie — tu copiezi și postezi. Nu postăm niciodată în locul tău."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth 负责写，你负责复制发布。我们绝不替你发布。"
          }
        }
      }
    },
