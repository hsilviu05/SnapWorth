    "Sold! Nice flip. Scan your next find while you're on a roll." : {
      "comment" : "Tag's tip on a find marked sold. Tag speaks in the first person, friendly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkauft! Starker Flip. Scanne gleich deinen nächsten Fund, solange es läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sold! Nice flip. Scan your next find while you're on a roll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Vendido! Buena reventa. Escanea tu próximo hallazgo ahora que estás en racha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vendu ! Belle revente. Scanne ta prochaine trouvaille tant que tu es lancé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venduto! Bella rivendita. Scansiona la prossima scoperta finché sei in vena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "売れた！ナイスなリセール。この勢いで次のお宝もスキャンしよう。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprzedane! Niezły flip. Skanuj kolejne znalezisko, póki dobrze idzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vendido! Boa revenda. Escaneie o próximo achado enquanto está embalado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vândut! Frumos flip. Scanează următoarea găsire cât ești în formă."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卖出啦！这单转得漂亮。趁手感正好，扫描下一件吧。"
          }
        }
      }
    },
