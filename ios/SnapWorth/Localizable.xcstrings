          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um amigo usou seu convite. Resgate sua semana grátis com a Apple."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
