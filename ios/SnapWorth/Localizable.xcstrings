    "A friend used your invite. Redeem your free week with Apple." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand hat deine Einladung genutzt. Löse deine Gratiswoche bei Apple ein."
