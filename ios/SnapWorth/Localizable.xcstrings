    "Photograph the care tag, size label or sole stamp and we'll re-read the item with both photos." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografier das Pflegeetikett, das Größenetikett oder die Sohlenprägung, und wir lesen den Artikel mit beiden Fotos neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photograph the care tag, size label or sole stamp and we'll re-read the item with both photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografía la etiqueta de cuidado, la de talla o el sello de la suela y volveremos a leer el artículo con las dos fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photographie l'étiquette d'entretien, de taille ou le marquage de la semelle, et on relira l'article avec les deux photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografa l'etichetta di lavaggio, della taglia o il timbro della suola, e rileggeremo l'articolo con entrambe le foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "洗濯表示、サイズタグ、ソールの刻印を撮影すると、2枚の写真でアイテムを読み直します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfotografuj metkę z instrukcją prania, rozmiarem lub nadruk na podeszwie, a odczytamy przedmiot ponownie z obu zdjęć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografe a etiqueta de lavagem, de tamanho ou o carimbo da sola, e vamos reler o item com as duas fotos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografiază eticheta de întreținere, cea de mărime sau ștampila de pe talpă și recitim obiectul cu ambele poze."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍一下洗标、尺码标或鞋底钢印，我们会用两张照片重新识别这件物品。"
          }
        }
      }
    },
    "Photograph the logo, the inside label, the stitching and the hardware, and we'll look for the usual signs of a replica." : {
      "comment" : "Legit check card on a result.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografiere Logo, Innenetikett, Nähte und Beschläge, und wir suchen nach den üblichen Anzeichen einer Replik."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photograph the logo, the inside label, the stitching and the hardware, and we'll look for the usual signs of a replica."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografía el logo, la etiqueta interior, las costuras y los herrajes, y buscaremos las señales habituales de una réplica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photographie le logo, l'étiquette intérieure, les coutures et les pièces métalliques, et on cherchera les signes habituels d'une contrefaçon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografa il logo, l'etichetta interna, le cuciture e la minuteria metallica, e cercheremo i segnali tipici di una replica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロゴ、内側のタグ、ステッチ、金具を撮影すると、よくある偽物のサインを探します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfotografuj logo, metkę wewnętrzną, szwy i okucia, a poszukamy typowych oznak podróbki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografe o logo, a etiqueta interna, as costuras e as ferragens, e vamos procurar os sinais comuns de réplica."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografiază logoul, eticheta interioară, cusăturile și accesoriile metalice, iar noi vom căuta semnele obișnuite ale unei replici."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
