    "Care tag, size label, sole stamp or serial plate. Hold steady — the small print is the point." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pflegeetikett, Größenetikett, Sohlenprägung oder Typenschild. Halt still – das Kleingedruckte ist der Punkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Care tag, size label, sole stamp or serial plate. Hold steady — the small print is the point."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiqueta de cuidado, de talla, sello de la suela o placa con el número de serie. No muevas el móvil: la letra pequeña es lo que importa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étiquette d'entretien, de taille, marquage de semelle ou plaque de série. Ne bouge pas : ce sont les petits caractères qui comptent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etichetta di lavaggio, della taglia, timbro sulla suola o targhetta del numero di serie. Tieni fermo: conta la scritta piccola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "洗濯表示、サイズタグ、ソールの刻印、シリアルプレート。小さな文字が大事なので、しっかり固定して。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metka z instrukcją prania, rozmiarem, nadruk na podeszwie lub tabliczka z numerem seryjnym. Trzymaj nieruchomo: liczy się drobny druk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiqueta de lavagem, de tamanho, carimbo da sola ou plaquinha de série. Segure firme: o que importa é a letra miúda."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eticheta de întreținere, cea de mărime, ștampila de pe talpă sau plăcuța cu seria. Ține telefonul fix — scrisul mărunt e important."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "洗标、尺码标、鞋底钢印或序列号铭牌都行。手拿稳一点，关键就在那些小字上。"
          }
        }
      }
    },
