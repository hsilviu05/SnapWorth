          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo la settimana gratis, l'abbonamento si rinnova a meno che tu non lo disdica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料の1週間のあとは、解約しない限り自動更新されます。"
