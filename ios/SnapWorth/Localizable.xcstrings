    "Plenty of these sell. Price near the middle of the range to sell it quickly." : {
      "comment" : "Tag's tip when the scan found twenty or more sold listings.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Davon wird viel verkauft. Setz den Preis etwa in die Mitte der Spanne, dann geht es schnell weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plenty of these sell. Price near the middle of the range to sell it quickly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se venden muchos como este. Ponle un precio cerca del centro del rango para venderlo rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s'en vend beaucoup. Fixe un prix vers le milieu de la fourchette pour vendre vite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ne vendono tanti. Metti un prezzo verso il centro dell'intervallo per venderlo in fretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはよく売れています。早く売るなら範囲の真ん中あたりの価格に。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takich rzeczy sprzedaje się dużo. Ustaw cenę w środku zakresu, by sprzedać szybko."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso vende bastante. Coloque o preço perto do meio da faixa para vender rápido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vând multe de felul ăsta. Pune un preț pe la mijlocul intervalului ca să-l vinzi repede."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这类东西卖得很多。定价在区间中间附近，能更快卖出。"
          }
        }
      }
    },
    "Point your camera at any thrift find and see its resale value in seconds — before you buy." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halt die Kamera auf irgendeinen Second-Hand-Fund und sieh in Sekunden, was er im Wiederverkauf bringt – bevor du kaufst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point your camera at any thrift find and see its resale value in seconds — before you buy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta con la cámara a cualquier cosa de segunda mano y mira en segundos cuánto vale en reventa, antes de comprarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointe ton appareil photo vers n'importe quelle trouvaille de friperie et découvre sa valeur de revente en quelques secondes, avant d'acheter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra con la fotocamera qualsiasi scoperta dell'usato e scopri in pochi secondi il suo valore di rivendita, prima di comprare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古着屋のお宝にカメラを向けるだけで、買う前に数秒でリセール価格が分かります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skieruj aparat na dowolne znalezisko z lumpeksu i w kilka sekund poznaj jego wartość odsprzedaży, zanim kupisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aponte a câmera para qualquer achado de brechó e veja o valor de revenda em segundos, antes de comprar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îndreaptă camera spre orice găsești la second hand și vezi în câteva secunde cât valorează la revânzare — înainte să cumperi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把相机对准任何二手好物，几秒就知道它转手能卖多少——在你掏钱之前。"
          }
        }
      }
    },
