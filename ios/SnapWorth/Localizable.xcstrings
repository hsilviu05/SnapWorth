    "Resale is an AI estimate and fees are approximate — treat the verdict as a guide, not a guarantee." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wiederverkaufswert ist eine KI-Schätzung und die Gebühren sind ungefähr – nimm das Urteil als Anhaltspunkt, nicht als Garantie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resale is an AI estimate and fees are approximate — treat the verdict as a guide, not a guarantee."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reventa es una estimación con IA y las comisiones son aproximadas: toma el veredicto como una orientación, no como una garantía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La revente est une estimation IA et les frais sont approximatifs : considère le verdict comme un repère, pas une garantie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rivendita è una stima IA e le commissioni sono approssimative: prendi il verdetto come un'indicazione, non una garanzia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リセール価格はAI査定で、手数料はおおよそです。判定は保証ではなく目安としてご覧ください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odsprzedaż to wycena AI, a prowizje są przybliżone: traktuj werdykt jako wskazówkę, nie gwarancję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A revenda é uma estimativa por IA e as taxas são aproximadas: use o veredito como referência, não como garantia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prețul de revânzare e o estimare AI, iar comisioanele sunt aproximative — ia verdictul ca pe un reper, nu ca pe o garanție."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转卖价是 AI 估算，手续费也是近似值——这个结论只能当参考，不是保证。"
          }
        }
      }
    },
