    "Unlimited scans are subject to fair use: very heavy use can pause scanning for up to an hour." : {
      "comment" : "Footnote under the paywall's list of what Pro includes. Qualifies the \"Unlimited scans\" row: Pro scans are capped per hour, and a device over the cap waits at most an hour.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unbegrenzte Scans unterliegen der fairen Nutzung: Bei sehr intensiver Nutzung kann das Scannen bis zu einer Stunde pausieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlimited scans are subject to fair use: very heavy use can pause scanning for up to an hour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los escaneos ilimitados están sujetos a un uso razonable: con un uso muy intensivo, el escaneo puede pausarse hasta una hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les scans illimités sont soumis à un usage raisonnable : une utilisation très intensive peut suspendre les scans jusqu'à une heure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scansioni illimitate sono soggette a uso corretto: un uso molto intenso può mettere in pausa le scansioni fino a un'ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無制限スキャンは適正利用の範囲内です。非常に多く使うと、スキャンが最大1時間止まることがあります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skany bez limitu podlegają zasadzie uczciwego korzystania: bardzo intensywne użycie może wstrzymać skanowanie nawet na godzinę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneamentos ilimitados estão sujeitos a uso justo: uso muito intenso pode pausar o escaneamento por até uma hora."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanările nelimitate sunt supuse utilizării rezonabile: la o folosire foarte intensă, scanarea se poate opri pentru cel mult o oră."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无限扫描适用合理使用原则：使用过于频繁时，扫描可能暂停，最长一小时。"
          }
        }
      }
    },
