        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A friend used your invite. Redeem your free week with Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un amigo ha usado tu invitación. Canjea tu semana gratis con Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ami a utilisé ton invitation. Récupère ta semaine gratuite auprès d'Apple."
