    "Guess before the estimate covers the price on every new result until you tap Reveal. Turn it off to see the number straight away." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Erst raten, dann schätzen“ verdeckt den Preis bei jedem neuen Ergebnis, bis du auf „Schätzung zeigen“ tippst. Schalt es aus, um die Zahl sofort zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guess before the estimate covers the price on every new result until you tap Reveal. Turn it off to see the number straight away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Adivina antes de ver la estimación» tapa el precio en cada resultado nuevo hasta que tocas «Ver la estimación». Desactívalo para ver el número directamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Deviner avant l'estimation » masque le prix sur chaque nouveau résultat jusqu'à ce que tu touches « Révéler l'estimation ». Désactive-le pour voir le chiffre tout de suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Indovina prima della stima» copre il prezzo su ogni nuovo risultato finché non tocchi «Mostra la stima». Disattivalo per vedere subito il numero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「査定の前に予想」をオンにすると、「査定額を表示」をタップするまで新しい結果の価格が隠れます。オフにするとすぐに数字が見えます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zgadnij przed wyceną” zakrywa cenę w każdym nowym wyniku, dopóki nie stukniesz „Pokaż wycenę”. Wyłącz, by od razu widzieć liczbę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Chutar antes da estimativa” esconde o preço em cada resultado novo até você tocar em “Revelar a estimativa”. Desative para ver o número na hora."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ghicește înainte de estimare” acoperă prețul pe fiecare rezultat nou, până apeși „Arată estimarea”. Oprește-l ca să vezi numărul direct."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，每条新结果都会先把价格盖住，直到你点“看估价”。关掉就直接显示数字。"
          }
        }
      }
    },
