        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google nie używa ich do trenowania swoich modeli, a my ich nie przechowujemy po udzieleniu odpowiedzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Google não usa esses dados para treinar os modelos dele, e nós não os guardamos depois que você recebe a resposta."
