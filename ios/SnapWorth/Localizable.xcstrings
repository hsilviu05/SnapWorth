    },
    "Your server data was deleted. Your subscription's record is kept while it's active, so Pro keeps working." : {
      "comment" : "After Delete my server data succeeded on a device with an active subscription, whose record the server keeps.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Serverdaten wurden gelöscht. Der Eintrag deines Abos bleibt, solange es aktiv ist, damit Pro weiter funktioniert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your server data was deleted. Your subscription's record is kept while it's active, so Pro keeps working."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminaron tus datos del servidor. El registro de tu suscripción se conserva mientras esté activa, para que Pro siga funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes données du serveur ont été supprimées. L'enregistrement de ton abonnement est conservé tant qu'il est actif, pour que Pro continue de fonctionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati sul server sono stati eliminati. Il record del tuo abbonamento viene conservato finché è attivo, così Pro continua a funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバー上のデータを削除しました。Proが使えるよう、有効なサブスクリプションの記録は保持されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje dane z serwera zostały usunięte. Zapis subskrypcji jest przechowywany, dopóki jest aktywna, żeby Pro dalej działało."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dados do servidor foram apagados. O registro da sua assinatura é mantido enquanto ela estiver ativa, para o Pro continuar funcionando."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele de pe server au fost șterse. Înregistrarea abonamentului se păstrează cât timp este activ, ca Pro să funcționeze în continuare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在服务器上的数据已删除。订阅有效期间会保留其记录，以便 Pro 继续可用。"
          }
        }
      }
    },
