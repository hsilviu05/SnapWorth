    "Guess before the estimate covers the price on every new result until you tap Reveal. Turn it off to see the number straight away." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Erst raten, dann schätzen“ verdeckt den Preis bei jedem neuen Ergebnis, bis du auf „Schätzung zeigen“ tippst. Schalt es aus, um die Zahl sofort zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guess before the estimate covers the price on every new result until you tap Reveal. Turn it off to see the number straight away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Adivina antes de ver la estimación» tapa el precio en cada resultado nuevo hasta que tocas «Ver la estimación». Desactívalo para ver el número directamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ghicește înainte de estimare” acoperă prețul pe fiecare rezultat nou, până apeși „Arată estimarea”. Oprește-l ca să vezi numărul direct."
          }
        }
      }
    },
