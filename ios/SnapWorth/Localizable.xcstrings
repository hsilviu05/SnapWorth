          "stringUnit" : {
            "state" : "translated",
            "value" : "After the free week, the subscription renews unless you cancel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras la semana gratis, la suscripción se renueva salvo que la canceles."
