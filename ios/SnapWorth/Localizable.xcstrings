    "Try closer, in better light, or a different rail. An empty answer is better than a guess." : {
      "comment" : "Rack scan: under 'Nothing stood out in this photo.'",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuche es näher, bei besserem Licht oder an einer anderen Stange. Keine Antwort ist besser als eine Vermutung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try closer, in better light, or a different rail. An empty answer is better than a guess."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba más cerca, con mejor luz o con otro perchero. Una respuesta vacía es mejor que una suposición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essaie plus près, avec plus de lumière, ou un autre portant. Une réponse vide vaut mieux qu'une supposition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova più da vicino, con più luce o un altro stender. Una risposta vuota è meglio di un'ipotesi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もっと近くで、明るい場所で、または別のラックでお試しください。当て推量より、空の答えのほうがましです。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spróbuj z bliska, przy lepszym świetle lub z innym wieszakiem. Pusta odpowiedź jest lepsza niż zgadywanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente mais perto, com mais luz, ou outra arara. Uma resposta vazia é melhor que um chute."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încearcă mai aproape, în lumină mai bună, sau alt stand. Un răspuns gol e mai bun decât o presupunere."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试试靠近一点、换个光线更好的地方，或换一个衣架。没有结果总比瞎猜好。"
