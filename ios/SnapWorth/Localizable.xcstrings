        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友だちがあなたの招待を使いました。Appleで無料の1週間を受け取りましょう。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
