    "A higher-value find. Buyers look closely, so photograph the label and every flaw." : {
      "comment" : "Tag's tip for a find worth $150 or more.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein wertvollerer Fund. Käufer schauen genau hin, also fotografiere das Etikett und jeden Makel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A higher-value find. Buyers look closely, so photograph the label and every flaw."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un hallazgo de más valor. Los compradores se fijan mucho, así que fotografía la etiqueta y cada defecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une trouvaille de valeur. Les acheteurs regardent de près, alors photographie l'étiquette et chaque défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una scoperta di valore. Gli acquirenti guardano bene, quindi fotografa l'etichetta e ogni difetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価値の高いお宝です。買い手はよく見るので、タグと傷をすべて撮影しましょう。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
