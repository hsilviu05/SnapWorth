    "Scan the item to get its resale value, add the shop price, and see your profit after fees — before you buy." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scann den Artikel für seinen Wiederverkaufswert, trag den Ladenpreis ein und sieh deinen Gewinn nach Gebühren – bevor du kaufst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the item to get its resale value, add the shop price, and see your profit after fees — before you buy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el artículo para saber cuánto vale en reventa, añade el precio de la tienda y mira tu ganancia tras comisiones, antes de comprarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne l'article pour connaître sa valeur de revente, ajoute le prix en boutique et vois ton bénéfice après frais, avant d'acheter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona l'articolo per conoscerne il valore di rivendita, aggiungi il prezzo in negozio e vedi il guadagno al netto delle commissioni, prima di comprare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイテムをスキャンしてリセール価格を調べ、店頭価格を入れれば、買う前に手数料を引いた利益が分かります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeskanuj przedmiot, by poznać wartość odsprzedaży, dodaj cenę ze sklepu i zobacz zysk po prowizjach, zanim kupisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie o item para saber o valor de revenda, adicione o preço da loja e veja seu lucro após as taxas, antes de comprar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanează obiectul ca să afli cât face la revânzare, adaugă prețul din magazin și vezi ce profit îți rămâne după comisioane — înainte să cumperi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫一下这件物品拿到转卖价，填上店里的价格，就能看到扣掉手续费后赚多少——在你掏钱之前。"
          }
        }
      }
    },
