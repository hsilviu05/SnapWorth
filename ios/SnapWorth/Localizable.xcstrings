    "You paid more than this usually sells for. Bundling it with something similar can make it worth listing." : {
      "comment" : "Tag's tip when the price paid is above the top of the estimate.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast mehr bezahlt, als es meist einbringt. Im Paket mit etwas Ähnlichem kann sich ein Inserat lohnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You paid more than this usually sells for. Bundling it with something similar can make it worth listing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagaste más de lo que suele venderse. Venderlo en un lote con algo parecido puede hacer que valga la pena anunciarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu l'as payé plus cher que son prix de revente habituel. Le vendre en lot avec quelque chose de similaire peut valoir le coup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'hai pagato più di quanto si vende di solito. Venderlo in blocco con qualcosa di simile può far valere la pena di metterlo in vendita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつもの相場より高く買っています。似たものとセットにすると出品する価値が出るかも。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapłacono więcej, niż to zwykle się sprzedaje. Sprzedaż w zestawie z czymś podobnym może sprawić, że warto to wystawić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pagou mais do que isso costuma vender. Vender junto com algo parecido pode fazer valer a pena anunciar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai plătit mai mult decât se vinde de obicei. Dacă îl vinzi la pachet cu ceva asemănător, poate merita listat."
