    "SnapWorth recognizes your subscription now. Please try again." : {
      "comment" : "Message under \"Subscription confirmed\". The request the server had refused is not re-run automatically, so the user is asked to repeat it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
