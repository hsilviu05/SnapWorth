    "That's at least double what you paid. Worth listing soon." : {
      "comment" : "Tag's tip when the likely value is at least twice the price paid.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist mindestens das Doppelte von dem, was du bezahlt hast. Bald inserieren lohnt sich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That's at least double what you paid. Worth listing soon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es al menos el doble de lo que pagaste. Vale la pena anunciarlo pronto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est au moins le double de ce que tu as payé. À mettre en vente vite."
          }
        },
        "it" : {
          "stringUnit" : {
