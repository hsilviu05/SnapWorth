    "Drafts use the same hourly limit as scans. Scanning may pause for up to an hour." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entwürfe nutzen dasselbe Stundenlimit wie Scans. Das Scannen kann bis zu einer Stunde pausieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drafts use the same hourly limit as scans. Scanning may pause for up to an hour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los borradores usan el mismo límite por hora que los escaneos. El escaneo puede pausarse hasta una hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les brouillons utilisent la même limite horaire que les scans. Les scans peuvent être en pause jusqu'à une heure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bozze usano lo stesso limite orario delle scansioni. Le scansioni possono andare in pausa fino a un'ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下書きはスキャンと同じ1時間あたりの上限を使います。スキャンが最大1時間止まることがあります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szkice mają ten sam limit godzinowy co skany. Skanowanie może wstrzymać się nawet na godzinę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os rascunhos usam o mesmo limite por hora dos escaneamentos. Escanear pode pausar por até uma hora."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciornele folosesc aceeași limită pe oră ca scanările. Scanarea se poate opri până la o oră."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "商品描述与扫描共用每小时上限，扫描可能会暂停最多一小时。"
