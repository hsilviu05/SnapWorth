    "NSCameraUsageDescription" : {
      "comment" : "Shown by iOS the first time the scanner opens the camera.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth nutzt deine Kamera, damit du Artikel fotografieren kannst – wir erkennen sie und schätzen, was sie im Wiederverkauf wert sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth uses your camera to photograph items so we can identify them and estimate their resale value."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth usa la cámara para que fotografíes artículos, reconocerlos y estimar cuánto valen en reventa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth utilise ton appareil photo pour photographier des articles afin de les identifier et d'estimer leur valeur de revente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth usa la fotocamera per fotografare gli articoli, così possiamo identificarli e stimarne il valore di rivendita."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth folosește camera ca să fotografiezi lucrurile găsite, să le recunoască și să estimeze cât valorează la revânzare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth 需要使用相机，让你拍下物品，我们来识别它并估算转卖价。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Shown the first time SnapWorth saves to Photos: a share card from the share sheet, or a cleaned-up listing photo from Snap → Sell.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube SnapWorth, Karten zum Teilen und freigestellte Fotos fürs Inserat in „Fotos“ zu sichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow SnapWorth to save share cards and cleaned-up listing photos to Photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que SnapWorth guarde en Fotos las tarjetas para compartir y las fotos de anuncios sin fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise SnapWorth à enregistrer les cartes de partage et les photos d'annonce détourées dans Photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a SnapWorth di salvare in Foto le card da condividere e le foto degli annunci scontornate."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite-i lui SnapWorth să salveze în Poze cardurile de distribuit și pozele curățate pentru anunțuri."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 SnapWorth 把分享卡片和去除背景的商品照片存到“照片”。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Shown when the user picks an existing photo to scan.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit SnapWorth kannst du Fotos aus deiner Mediathek wählen, um ihren Wiederverkaufswert zu erfahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth lets you pick photos from your library to scan for resale value."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth te deja elegir fotos de tu galería para saber cuánto vale en reventa lo que sale en ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth te permet de choisir des photos dans ta photothèque pour estimer leur valeur de revente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth ti permette di scegliere foto dalla libreria da scansionare per conoscerne il valore di rivendita."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth îți lasă să alegi poze din galerie, ca să afli cât valorează la revânzare ce e în ele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapWorth 需要访问相册，让你挑选照片来查看照片里物品的转卖价。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
