<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- None. The extension makes no network request and links no SDK: it
	     reads what the app wrote to the App Group and draws it, and the one
	     thing it writes back is a Control Centre tap for the app to act on.
	     Everything the app sends is declared in the app's own manifest,
	     ios/SnapWorth/PrivacyInfo.xcprivacy. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<!-- 1C8F.1: the group.eu.snapworth.app suite, and nothing else.
			     WidgetReader.readHaul reads the app's snapshot from it, and
			     WidgetBridge.request / takePendingAction (the shared widget
			     model) pass a Control Centre tap to the app through it. The
			     extension never touches UserDefaults.standard, so CA92.1,
			     which the app declares, is not claimed here. -->
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
